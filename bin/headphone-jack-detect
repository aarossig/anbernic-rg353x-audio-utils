#!/bin/bash
#
# headphone-jack-detect: Automatic audio jack detection & switching daemon
# Designed for Anbernic RG353 series (RG353V, RG353VS, RG353M, RG353P)
# with Rockchip RK3566 + RK817 audio codec.
#
# Automatically switches ALSA 'Playback Mux' between 'SPK' (Speaker) and
# 'HP' (Headphones) on insertion/removal, applies correct settings at boot,
# routes between PipeWire virtual sinks (190Hz Butterworth HPF for speaker,
# full-range for headphones), and preserves separate volume memory across outputs.
#
# License: GPL-2.0-or-later
#

set -uo pipefail

ALSACTL="/usr/sbin/alsactl"
if [ ! -x "$ALSACTL" ]; then
    ALSACTL=$(command -v alsactl || true)
fi

if [ -z "$ALSACTL" ]; then
    echo "[headphone-jack-detect] Error: alsactl not found. Please install alsa-utils." >&2
    exit 1
fi

# Calibrated hardware Master volume register levels (0-255)
# 215 = 84% (-14.90 dB): internal speaker calibrated clean operating ceiling
# 240 = 94% (-5.59 dB): headphone amplifier clean operating level
CALIBRATED_SPK_MASTER=215
CALIBRATED_HP_MASTER=240

# Default PipeWire software volumes (0.0 - 1.0)
DEFAULT_SPK_VOL="0.80"
DEFAULT_HP_VOL="0.60"

STATE_DIR="/var/lib/anbernic-rg353x-audio-utils"
if ! mkdir -p "$STATE_DIR" 2>/dev/null; then
    STATE_DIR="/run/anbernic-rg353x-audio-utils"
    mkdir -p "$STATE_DIR" 2>/dev/null || true
fi
SPK_VOL_FILE="$STATE_DIR/spk_volume"
HP_VOL_FILE="$STATE_DIR/hp_volume"

find_rk817_card() {
    # 1. Sysfs symlink check
    if [ -e "/proc/asound/rk817int" ]; then
        echo "rk817int"
        return 0
    fi
    # 2. Extract card name directly from /proc/asound/cards
    local detected
    detected=$(awk -F'[][]' '/rk817|platform-sound/ {gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit}' /proc/asound/cards 2>/dev/null || true)
    if [ -n "$detected" ]; then
        echo "$detected"
        return 0
    fi
    # 3. Check for Playback Mux control across available cards
    for card_idx in 0 1 2 3; do
        if amixer -c "$card_idx" cget name='Playback Mux' >/dev/null 2>&1; then
            echo "$card_idx"
            return 0
        fi
    done
    return 1
}

CARD=""
CURRENT_OUTPUT=""

get_sink_volume() {
    local sink_target="$1"
    local vol=""
    for sock in /run/user/*/pipewire-0; do
        if [ -S "$sock" ]; then
            local uid
            uid=$(basename "$(dirname "$sock")")
            local id
            id=$(XDG_RUNTIME_DIR="/run/user/$uid" pw-cli info "$sink_target" 2>/dev/null | awk '/^[ \t]*id:/ {print $2; exit}' || true)
            if [ -n "$id" ]; then
                vol=$(XDG_RUNTIME_DIR="/run/user/$uid" wpctl get-volume "$id" 2>/dev/null | awk '{print $2}' || true)
                vol=$(echo "$vol" | tr -dc '0-9.')
                if [ -n "$vol" ]; then
                    echo "$vol"
                    return 0
                fi
            fi
        fi
    done
    return 1
}

set_sink_volume() {
    local sink_target="$1"
    local vol="$2"
    [ -z "$vol" ] && return 1

    # Normalize integer percentages (> 1.5) to decimals (e.g., 67 -> 0.67, 100 -> 1.00)
    # Floating point volume boosts up to 1.5 (150%) are preserved (e.g., 1.12 stays 1.12)
    vol=$(echo "$vol" | tr -d '%')
    vol=$(awk -v v="$vol" 'BEGIN { if (v > 1.5) printf "%.2f", v/100.0; else printf "%.2f", v }' 2>/dev/null || echo "$vol")

    for sock in /run/user/*/pipewire-0; do
        if [ -S "$sock" ]; then
            local uid
            uid=$(basename "$(dirname "$sock")")
            local id
            id=$(XDG_RUNTIME_DIR="/run/user/$uid" pw-cli info "$sink_target" 2>/dev/null | awk '/^[ \t]*id:/ {print $2; exit}' || true)
            if [ -n "$id" ]; then
                XDG_RUNTIME_DIR="/run/user/$uid" wpctl set-volume -l 1.5 "$id" "$vol" >/dev/null 2>&1 || true
            fi
        fi
    done
}

set_sink_mute() {
    local sink_target="$1"
    local mute_val="$2"
    for sock in /run/user/*/pipewire-0; do
        if [ -S "$sock" ]; then
            local uid
            uid=$(basename "$(dirname "$sock")")
            local id
            id=$(XDG_RUNTIME_DIR="/run/user/$uid" pw-cli info "$sink_target" 2>/dev/null | awk '/^[ \t]*id:/ {print $2; exit}' || true)
            [ -n "$id" ] && XDG_RUNTIME_DIR="/run/user/$uid" wpctl set-mute "$id" "$mute_val" >/dev/null 2>&1 || true
        fi
    done
}

set_pipewire_sink() {
    local sink_target="$1"
    for sock in /run/user/*/pipewire-0; do
        if [ -S "$sock" ]; then
            local uid
            uid=$(basename "$(dirname "$sock")")
            XDG_RUNTIME_DIR="/run/user/$uid" pw-metadata -n default 0 default.audio.sink "{\"name\":\"$sink_target\"}" >/dev/null 2>&1 || true
            if command -v wpctl >/dev/null 2>&1; then
                local id
                id=$(XDG_RUNTIME_DIR="/run/user/$uid" pw-cli info "$sink_target" 2>/dev/null | awk '/^[ \t]*id:/ {print $2; exit}' || true)
                if [ -n "$id" ]; then
                    XDG_RUNTIME_DIR="/run/user/$uid" wpctl set-default "$id" >/dev/null 2>&1 || true
                fi
            fi
        fi
    done
}

echo "[headphone-jack-detect] Waiting for RK817 sound card..."
for _ in $(seq 1 30); do
    if CARD=$(find_rk817_card); then
        break
    fi
    sleep 0.5
done

if [ -z "$CARD" ]; then
    echo "[headphone-jack-detect] Error: RK817 sound card with 'Playback Mux' not detected after 15s." >&2
    exit 1
fi

echo "[headphone-jack-detect] Bound to sound card: hw:$CARD"

sync_state() {
    local jack_out target current current_mux vol
    # Debounce mechanical contact bounce
    sleep 0.05

    jack_out=$(amixer -c "$CARD" cget iface=CARD,name='Headphones Jack' 2>/dev/null || true)
    case "$jack_out" in
        *": values=on"*)
            target="HP"
            ;;
        *)
            target="SPK"
            ;;
    esac

    current=$(amixer -c "$CARD" cget name='Playback Mux' 2>/dev/null || true)
    current_mux=""
    case "$current" in
        *": values=0"*) current_mux="HP" ;;
        *": values=1"*) current_mux="SPK" ;;
    esac

    if [ "$target" = "$CURRENT_OUTPUT" ] && [ "$target" = "$current_mux" ]; then
        return 0
    fi

    echo "[headphone-jack-detect] Jack event: switching to $target (previous: ${CURRENT_OUTPUT:-boot})"

    local is_dynamic_switch=false
    if [ -n "$CURRENT_OUTPUT" ] && [ "$CURRENT_OUTPUT" != "$target" ]; then
        is_dynamic_switch=true
        # STAGE 1: Instantly mute hardware and software at t=0ms
        amixer -c "$CARD" cset name='Master Playback Volume' 0 >/dev/null 2>&1 || true
        set_sink_mute "sink.anbernic-speaker" 1
        set_sink_mute "sink.anbernic-headphones" 1

        # Save previous sink volume while muted
        if [ "$CURRENT_OUTPUT" = "HP" ]; then
            vol=$(get_sink_volume "sink.anbernic-headphones" || true)
            if [ -n "$vol" ]; then
                echo "$vol" > "$HP_VOL_FILE" 2>/dev/null || true
                echo "[headphone-jack-detect] Saved headphone volume: $vol"
            fi
        else
            vol=$(get_sink_volume "sink.anbernic-speaker" || true)
            if [ -n "$vol" ]; then
                echo "$vol" > "$SPK_VOL_FILE" 2>/dev/null || true
                echo "[headphone-jack-detect] Saved speaker volume: $vol"
            fi
        fi

        # Wait 150ms in total silence for DAC rampdown and cone settling
        sleep 0.15
    fi

    # Keep underlying hardware ALSA sink at unity gain (1.0)
    set_sink_volume "alsa_output.platform-sound.stereo-fallback" "1.0"

    # STAGE 2: Set target output settings while still muted
    if [ "$target" = "HP" ]; then
        # Switch physical multiplexer to Headphones
        amixer -c "$CARD" cset name='Playback Mux' 'HP' >/dev/null 2>&1 || true

        # Restore headphone volume on virtual sink
        local hp_vol="$DEFAULT_HP_VOL"
        if [ -f "$HP_VOL_FILE" ]; then
            local saved_hp
            saved_hp=$(cat "$HP_VOL_FILE" 2>/dev/null || true)
            saved_hp=$(echo "$saved_hp" | tr -dc '0-9.')
            [ -n "$saved_hp" ] && hp_vol="$saved_hp"
        fi
        set_sink_volume "sink.anbernic-headphones" "$hp_vol"
        echo "[headphone-jack-detect] Restored headphone volume: $hp_vol"

        # Switch PipeWire default sink to headphones
        set_pipewire_sink "sink.anbernic-headphones"

        if [ "$is_dynamic_switch" = true ]; then
            # STAGE 3: Wait 150ms for stream migration and buffers to settle in silence
            sleep 0.15
        fi

        # STAGE 4: Unmute hardware master to calibrated operating level and unmute headphone sink
        amixer -c "$CARD" cset name='Master Playback Volume' "$CALIBRATED_HP_MASTER" >/dev/null 2>&1 || true
        set_sink_mute "sink.anbernic-headphones" 0
    else
        # Switch physical multiplexer to Speaker
        amixer -c "$CARD" cset name='Playback Mux' 'SPK' >/dev/null 2>&1 || true

        # Restore speaker volume on virtual sink
        local spk_vol="$DEFAULT_SPK_VOL"
        if [ -f "$SPK_VOL_FILE" ]; then
            local saved_spk
            saved_spk=$(cat "$SPK_VOL_FILE" 2>/dev/null || true)
            saved_spk=$(echo "$saved_spk" | tr -dc '0-9.')
            [ -n "$saved_spk" ] && spk_vol="$saved_spk"
        fi
        set_sink_volume "sink.anbernic-speaker" "$spk_vol"
        echo "[headphone-jack-detect] Restored speaker volume: $spk_vol"

        # Switch PipeWire default sink to speaker
        set_pipewire_sink "sink.anbernic-speaker"

        if [ "$is_dynamic_switch" = true ]; then
            # STAGE 3: Wait 150ms for stream migration and buffers to settle in silence
            sleep 0.15
        fi

        # STAGE 4: Unmute hardware master to calibrated speaker ceiling and unmute speaker sink
        amixer -c "$CARD" cset name='Master Playback Volume' "$CALIBRATED_SPK_MASTER" >/dev/null 2>&1 || true
        set_sink_mute "sink.anbernic-speaker" 0
    fi

    CURRENT_OUTPUT="$target"
}

# Initial synchronization on startup
sync_state

# Clean termination
cleanup() {
    echo "[headphone-jack-detect] Terminating cleanly..."
    if [ -n "$CURRENT_OUTPUT" ]; then
        if [ "$CURRENT_OUTPUT" = "HP" ]; then
            vol=$(get_sink_volume "sink.anbernic-headphones" || true)
            [ -n "$vol" ] && echo "$vol" > "$HP_VOL_FILE" 2>/dev/null || true
        else
            vol=$(get_sink_volume "sink.anbernic-speaker" || true)
            [ -n "$vol" ] && echo "$vol" > "$SPK_VOL_FILE" 2>/dev/null || true
        fi
    fi
    trap '' SIGTERM SIGINT EXIT
    kill 0 2>/dev/null || true
    exit 0
}
trap cleanup SIGTERM SIGINT EXIT

# Event loop
while true; do
    while read -r line; do
        case "$line" in
            *"Headphones Jack"*)
                sync_state
                # Drain any bounce events that accumulated during the switch
                while read -t 0.05 -r _; do :; done
                ;;
        esac
    done < <(exec "$ALSACTL" monitor "hw:$CARD" 2>/dev/null)

    echo "[headphone-jack-detect] Monitor exited. Re-checking sound card in 2 seconds..."
    sleep 2
    if new_card=$(find_rk817_card); then
        CARD="$new_card"
    fi
    sync_state
done

