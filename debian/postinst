#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    # Migrate any legacy diversions from anbernic-rg353x-headphone-detect
    for ucm_conf in /usr/share/alsa/ucm2/conf.d/simple-card/rk817_int.conf \
                    /usr/share/alsa/ucm2/conf.d/simple-card/rk817_ext.conf; do
        if dpkg-divert --list "$ucm_conf" 2>/dev/null | grep -q "anbernic-rg353x-headphone-detect"; then
            dpkg-divert --package anbernic-rg353x-headphone-detect --remove --rename \
                --divert "${ucm_conf}.disabled" "$ucm_conf" >/dev/null 2>&1 || true
        fi
        if [ -e "$ucm_conf" ] || dpkg-divert --list "$ucm_conf" >/dev/null 2>&1; then
            dpkg-divert --package anbernic-rg353x-audio-utils --add --rename \
                --divert "${ucm_conf}.disabled" "$ucm_conf" >/dev/null 2>&1 || true
        fi
    done

    # Create state directory
    mkdir -p /var/lib/anbernic-rg353x-audio-utils
    chmod 755 /var/lib/anbernic-rg353x-audio-utils
fi

#DEBHELPER#

exit 0
